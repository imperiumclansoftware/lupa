# Copié vers .env par `make init` (les valeurs __GENERATED__ sont remplacées par des secrets aléatoires)
COMPOSE_PROJECT_NAME=sas

# http://collecte.localhost:8090 et http://miroir.localhost:8090
# (*.localhost pointe toujours sur 127.0.0.1, aucun /etc/hosts à modifier)
COLLECTOR_DOMAIN=collecte.localhost
MIRROR_DOMAIN=miroir.localhost

# Port local HTTP (lié à 127.0.0.1 uniquement)
HTTP_PORT=8090

# Utilisateur des conteneurs (rempli par `make init`) :
#  0 en Docker rootless (root du conteneur = votre utilisateur hôte, sans privilège), sinon votre UID/GID
APP_UID=0
APP_GID=0

PHP_VERSION=8.4
NODE_VERSION=24

COLLECTOR_SECRET=__GENERATED__
MIRROR_SECRET=__GENERATED__

# Facultatif : évite les limites de débit anonymes
# GitHub (archives des paquets Composer) : jeton sans aucune permission
GITHUB_TOKEN=
# Docker Hub : identifiant + jeton d'accès en lecture seule
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Scrutation des fichiers Angular en ms (vide en rootless, 1000 sous Docker Desktop)
NG_POLL=
