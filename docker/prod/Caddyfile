# Sas en production : HTTP sur le port 8080 (placer un reverse proxy HTTPS devant si besoin)
{
	frankenphp
	auto_https off
	admin off
}

:8080 {
	log
	log_skip /healthz

	handle /healthz {
		respond 200
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# API d'administration et registres (npm, PyPI, Composer, Docker) : Symfony
	@php path /api/* /npm /npm/* /pypi/* /composer/* /v2 /v2/* /deb/* /rpm/* /galaxy/* /terraform/* /.well-known/terraform.json
	handle @php {
		php_server {
			root /app/public
		}
	}

	# Interface Angular : fichiers statiques, index.html pour les routes de l'application
	handle {
		encode zstd gzip
		root * /srv/front
		header X-Frame-Options "DENY"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@hashed path_regexp \-[A-Z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
