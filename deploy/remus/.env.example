# Image (mise à jour par ./configure.sh à chaque nouveau kit)
REMUS_IMAGE=iemperor/remus:latest

# Interface : 127.0.0.1 = cette machine seulement ; 0.0.0.0 = tout le réseau local
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Dossier d'export sur l'hôte : clé USB montée (ex. /media/moi/CLE) ou dossier intermédiaire
EXPORT_DIR=./exports

# Facultatif : évite les limites de débit anonymes
GITHUB_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Registres amont (ex. un proxy d'entreprise compatible)
NPM_REGISTRY=https://registry.npmjs.org
PYPI_INDEX=https://pypi.org

# Secrets : rien à renseigner, ils sont générés au premier démarrage et conservés dans le volume « data ».
# Pour les fournir vous-même (ex. Docker secrets) : APP_SECRET, ou APP_SECRET_FILE=/run/secrets/app_secret
APP_SECRET=
APP_SECRET_FILE=

# Réinstallation de Rémus sur une nouvelle machine : clé de signature de l'ancien (contenu de
# /data/identity/secret.key), pour que les miroirs continuent d'accepter ses bundles.
# Utilisée seulement s'il n'y a pas encore de clé dans le volume ; peut être retirée ensuite.
REMUS_SIGNING_KEY=
REMUS_SIGNING_KEY_FILE=
