# Image (mise à jour par ./configure.sh à chaque nouveau kit)
ROMULUS_IMAGE=iemperor/romulus:latest

# Port d'écoute du miroir (les postes clients l'utilisent : http://serveur:8080)
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# Adresse publique du miroir, si un reverse proxy HTTPS est placé devant (ex. https://miroir.intranet)
PUBLIC_URL=

# Dossier où les clés USB sont montées sur le serveur
USB_DIR=/media

# Secrets : rien à renseigner, ils sont générés au premier démarrage et conservés dans le volume « data ».
# Pour les fournir vous-même (ex. Docker secrets) : APP_SECRET, ou APP_SECRET_FILE=/run/secrets/app_secret
APP_SECRET=
APP_SECRET_FILE=
