SAS_COLLECTOR_IMAGE=sas-collector:latest

# Interface : 127.0.0.1 = cette machine seulement ; 0.0.0.0 = tout le réseau local
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Dossier d'export sur l'hôte : clé USB montée (ex. /media/moi/CLE) ou dossier intermédiaire
EXPORT_DIR=./exports


# Facultatif : évite les limites de débit anonymes
GITHUB_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Registres amont (ex. un proxy d'entreprise compatible)
NPM_REGISTRY=https://registry.npmjs.org
PYPI_INDEX=https://pypi.org
