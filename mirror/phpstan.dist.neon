includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - ../shared/src
    excludePaths:
        - tests/bootstrap.php
    tmpDir: var/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
